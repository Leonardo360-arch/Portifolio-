Options -Indexes

# Bloqueia .env e qualquer arquivo oculto (compatível Apache 2.4 e 2.2)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Impede execução de PHP em uploads
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F,L]
</IfModule>

# Nao expor schema, exemplos de env nem documentacao
<FilesMatch "\.(sql|md|example|yml|json|ini|sh|conf)$|^Dockerfile$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
